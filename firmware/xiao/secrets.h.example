// Plantilla de secrets.h. Copiar a secrets.h (que git ignora) y poner los valores
// reales. Nunca subir secrets.h ni pegar sus valores en un documento o un chat.
#pragma once

#include <stdint.h>

// Wi-Fi de 2.4 GHz al que se conecta la XIAO (el ESP32-S3 no usa 5 GHz).
constexpr const char* WIFI_SSID = "cambiar_ssid";
constexpr const char* WIFI_CLAVE = "cambiar_esta_clave";

// Broker Mosquitto de la Orange Pi: IP o nombre de la placa en esa red.
constexpr const char* MQTT_HOST = "cambiar_host_del_broker";
constexpr uint16_t MQTT_PUERTO = 1883;

// Usuario fijo "xiao" (docs/contrato-mqtt.md, sección 6). Su clave es la
// MQTT_XIAO_PASSWORD de orangepi/.env: pídesela a Yordi, no la copies de ahí.
constexpr const char* MQTT_USUARIO = "xiao";
constexpr const char* MQTT_CLAVE = "cambiar_esta_clave";

// Secreto compartido con el servicio de visión para la firma HMAC del endpoint
// /capture (cabecera X-Captura-HMAC). Es el mismo valor que
// CAPTURA_HMAC_SECRETO en /etc/pase-lista/vision.env (en la Orange Pi), pero
// aquí se escribe a mano: el equipo lo pone al final, cuando la placa y el
// servicio de visión estén montados. Si no coinciden, la visión no consegue
// las fotos y el firmware responde 401.
constexpr const char* CAPTURA_HMAC_SECRETO = "cambiar_esta_clave";

// IP fija (opcional). Por defecto la XIAO pide su IP por DHCP. Para fijarla,
// quita el "//" de las tres primeras líneas (la cuarta es opcional) y pon los
// valores de tu red; la IP debe quedar fuera del rango del DHCP del router.
// Si falta alguna de las tres, o alguna está vacía o mal escrita, se usa DHCP.
// IP_DNS es opcional: sin ella se usa la puerta de enlace como DNS. Son macros
// y no constantes para que un secrets.h anterior, que no las tiene, siga
// compilando.
// #define IP_ESTATICA "192.168.1.50"
// #define IP_PUERTA_ENLACE "192.168.1.1"
// #define IP_MASCARA "255.255.255.0"
// #define IP_DNS "192.168.1.1"

// IP del origen permitido en el puerto 80 (OBLIGATORIA): la IP desde la que el
// puente (relay) o el servicio de visión llega a /capture. La XIAO rechaza las
// conexiones de cualquier otra IP; sin esta línea el firmware no compila, y una IP
// mal escrita impide que la cámara arranque. Sirve contra un cliente cualquiera
// de la LAN (que retendría sockets o probaría firmas), no contra quien suplante
// esa IP (ARP spoofing): lo que autentica es la firma HMAC.
#define RELAY_IP "192.168.1.20"

// Imagen de la cámara girada 180 grados (opcional, 0 o 1). Ponla en 1 si la
// placa va montada al revés en la protoboard: la XIAO gira la foto en el sensor
// y el servicio de visión la recibe derecha. Es una macro y no una constante
// para que un secrets.h anterior, que no la tiene, siga compilando (vale 0).
#define CAMARA_GIRADA_180 0

// Borrar el piso de ts de la flash (opcional, solo para salir de apuros). La
// placa guarda en la flash el último ts aceptado para rechazar reenvíos tras un
// reinicio; si por un ts absurdo ese piso quedara fuera de alcance, descomenta la
// línea, flashea, y QUÍTALA tras un arranque (con ella puesta, cada reinicio
// borra el piso y vuelve la ventana de reenvío). Alternativa sin reflashear:
// mantener BOOT pulsado 1 s en los 3 s siguientes al arranque (no al dar
// corriente: con BOOT pulsado al encender, el chip entra en modo de descarga).
// #define CAPTURA_BORRAR_PISO_TS
