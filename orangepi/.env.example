# Credenciales del stack de la Orange Pi.
# Copiar a .env en esta misma carpeta (orangepi/.env, que git ignora) y cambiar
# TODOS los valores. Es el único .env del repo: Compose lo lee desde aquí.
# (El plan, sección 11, lo ubica en la raíz; se movió junto al compose para que
# Compose lo encuentre sin pasos extra y para que git lo ignore por su ubicación.)
# Usar solo letras y números en las contraseñas:
#   openssl rand -hex 16
# Las de MQTT (MQTT_*_PASSWORD) son estrictas: el broker no arranca si llevan algo
# que no sea [A-Za-z0-9], porque ":" o un salto de línea romperían el archivo de
# contraseñas de Mosquitto sin avisar.
#
# Los valores de POSTGRES_*, NODERED_DB_* y PORTAINER_ADMIN_PASSWORD solo se leen
# cuando se crea su volumen por primera vez (Postgres y Portainer). Cambiarlos
# después no surte efecto: hay que usar ALTER ROLE en Postgres (o repetir
# sql/roles.sh para el rol de Node-RED), cambiar la contraseña desde Portainer,
# o borrar los volúmenes con "docker compose down -v".

# Mosquitto: un usuario por rol, con nombre fijo (docs/contrato-mqtt.md, sección 6)
# y contraseña propia. Los nombres de usuario no se configuran: son xiao, vision,
# nodered, pantalla y simulador. La de vision se copia también a MQTT_PASSWORD en
# /etc/pase-lista/vision.env del servicio de visión; la de xiao va en el firmware
# y la de pantalla en el programa de la pantalla (ver orangepi/README.md).
MQTT_XIAO_PASSWORD=cambiar_esta_clave
MQTT_VISION_PASSWORD=cambiar_esta_clave
MQTT_NODERED_PASSWORD=cambiar_esta_clave
MQTT_PANTALLA_PASSWORD=cambiar_esta_clave
MQTT_SIMULADOR_PASSWORD=cambiar_esta_clave

# Postgres: superusuario (solo para administrar; Node-RED no lo usa)
POSTGRES_USER=aula
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=aula

# Postgres: rol de Node-RED, solo con SELECT/INSERT sobre las tablas que usa
NODERED_DB_USER=nodered
NODERED_DB_PASSWORD=cambiar_esta_clave

# Editor de Node-RED (adminAuth)
NODERED_ADMIN_USER=admin
NODERED_ADMIN_PASSWORD=cambiar_esta_clave

# Certificado HTTPS de Node-RED (autofirmado): nombres y direcciones por las que
# se abrirá, en formato subjectAltName de openssl. Opcional; por omisión:
#   DNS:localhost,IP:127.0.0.1
# Ejemplo con la IP de la placa y su nombre mDNS (poner la IP real):
#   NODERED_TLS_SAN=DNS:localhost,IP:127.0.0.1,IP:192.168.1.50,DNS:orangepi.local
# Al cambiarla, el certificado se regenera al reiniciar Node-RED.

# Portainer: contraseña del administrador (mínimo 12 caracteres)
PORTAINER_ADMIN_PASSWORD=cambiar_esta_clave_larga

# Token de GET /api/galeria (encabezado X-Galeria-Token). Se usa desde el 11 nov,
# cuando entra httpNodeAuth; todavía ningún contenedor lo recibe. Solo lo tendrán
# Node-RED y el servicio de visión, nunca el navegador.
GALERIA_TOKEN=cambiar_esta_clave
