[Unit]
Description=Servicio de vision de AutoList (pase de lista con reconocimiento facial)
# time-sync.target: el servicio firma sus peticiones de captura con la hora del reloj de pared,
# y la placa (XIAO) guarda el ultimo ts que acepto: un ts equivocado (un reloj sin sincronizar
# o con un salto) la deja rechazando con 403 las capturas buenas hasta que se reinicie. Hay que
# arrancar con la hora ya sincronizada. OJO: time-sync.target solo significa "sincronizada" si
# hay un servicio que espere a la sincronizacion y se ordene antes de el. Con systemd-timesyncd
# (el de la imagen de la Orange Pi) hay que habilitar:
#     sudo systemctl enable systemd-time-wait-sync.service
# (con chrony, chrony-wait.service). Sin eso, el target se alcanza al instante y el orden no
# protege de nada. Instala tambien el drop-in systemd-time-wait-sync.service.d/limite-autolist.conf
# (espera de 120 s como mucho): sin el, un aula sin internet deja este servicio sin arrancar.
# Ver orangepi/vision/README.md, "El reloj del borde".
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=orangepi
Group=orangepi
# Directorio de estado: systemd crea /var/lib/autolist (del usuario del servicio, modo 0700) y
# es donde el servicio guarda el ultimo ts firmado (reloj-captura.estado, captura.estado_reloj)
# para anclar la primera firma tras un reinicio cuando la Orange Pi no tiene RTC. Es lo unico
# que escribe. Con ProtectSystem=full, /var sigue siendo escribible.
StateDirectory=autolist
StateDirectoryMode=0700
WorkingDirectory=/var/lib/autolist
# Las credenciales (contrasena del broker y token de la galeria) van aqui, no en el
# archivo de configuracion: este lo puede leer cualquiera.
EnvironmentFile=/etc/pase-lista/vision.env
ExecStart=/usr/local/bin/vision_service --config /etc/pase-lista/vision.conf
# SIGTERM: el servicio para el bucle, cancela el enrolamiento en curso, apaga la luz,
# publica el estado final (en_linea false) y sale con codigo 0. TimeoutStopSec le da
# margen para esa salida ordenada: el bucle puede estar en una recarga de la galeria
# (5 s) o en una captura (2 s).
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
# Codigo 78 (EX_CONFIG): los errores de configuracion, que son "faltan los modelos .nb",
# "el .nb no encaja con el codigo", "el archivo de configuracion no es valido" o "falta
# una variable de entorno". Son fallos de configuracion, no del proceso: sin esta linea,
# systemd lo relanzaria cada 5 s para siempre y llenaria el journal.
RestartPreventExitStatus=78
# Endurecimiento moderado: el servicio solo necesita leer su configuracion y abrir la
# NPU (/dev/vipcore). No se usa ProtectSystem=strict ni reglas de dispositivo, para no
# impedirle el acceso a /dev/vipcore.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
LimitCORE=0
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
