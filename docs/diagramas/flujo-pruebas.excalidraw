    {
      "id": "63616264",
      "type": "text",
      "x": 555,
      "y": 590,
      "width": 334.0799999999999,
      "height": 105.0,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 365004893,
      "version": 1,
      "versionNonce": 188008666,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Registro (5 tomas):\n  Promedia vectores unitarios -> POST a Node-RED\n\u2022 Identificaci\u00f3n (1 toma):\n  Similitud coseno vs galer\u00eda local:\n  distancia = 1.000 (Umbral aceptaci\u00f3n >= 0.40)\n\u2022 M\u00e9trica Total de Latencia:\n  Captura HTTP + Decodificaci\u00f3n + NPU = 179 ms",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10.8,
      "containerId": null,
      "originalText": "\u2022 Registro (5 tomas):\n  Promedia vectores unitarios -> POST a Node-RED\n\u2022 Identificaci\u00f3n (1 toma):\n  Similitud coseno vs galer\u00eda local:\n  distancia = 1.000 (Umbral aceptaci\u00f3n >= 0.40)\n\u2022 M\u00e9trica Total de Latencia:\n  Captura HTTP + Decodificaci\u00f3n + NPU = 179 ms",
      "lineHeight": 1.25
    },
