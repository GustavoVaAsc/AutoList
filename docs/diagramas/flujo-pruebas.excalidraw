    {
      "id": "81794522",
      "type": "text",
      "x": 1015,
      "y": 970,
      "width": 354.96,
      "height": 120.0,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
