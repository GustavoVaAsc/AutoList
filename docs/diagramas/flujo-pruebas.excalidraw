      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Disparo por proximidad de persona\n\u2022 En pruebas de integraci\u00f3n:\n  Inyecci\u00f3n MQTT a t\u00f3pico aula/camara/pir\n\u2022 Payload: {\"movimiento\": true}\n\u2022 Despierta el ciclo de asistencia",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11.700000000000001,
      "containerId": null,
      "originalText": "\u2022 Disparo por proximidad de persona\n\u2022 En pruebas de integraci\u00f3n:\n  Inyecci\u00f3n MQTT a t\u00f3pico aula/camara/pir\n\u2022 Payload: {\"movimiento\": true}\n\u2022 Despierta el ciclo de asistencia",
      "lineHeight": 1.25
    },
