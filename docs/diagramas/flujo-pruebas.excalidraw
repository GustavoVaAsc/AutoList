      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 479761783,
      "version": 1,
      "versionNonce": 386935356,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 El profesor pulsa el bot\u00f3n f\u00edsico en pantalla\n\u2022 La pantalla invoca la finalizaci\u00f3n de sesi\u00f3n\n\u2022 Node-RED realiza el cierre administrativo:\n  - Marca la sesi\u00f3n 20 como completada\n  - Registra a los 8 alumnos restantes como 'falta'\n  - Exporta autom\u00e1ticamente el archivo CSV:\n    /data/reportes/sesion-20.csv\n\u2022 Confirmaci\u00f3n instant\u00e1nea en la interfaz f\u00edsica",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10.8,
      "containerId": null,
      "originalText": "\u2022 El profesor pulsa el bot\u00f3n f\u00edsico en pantalla\n\u2022 La pantalla invoca la finalizaci\u00f3n de sesi\u00f3n\n\u2022 Node-RED realiza el cierre administrativo:\n  - Marca la sesi\u00f3n 20 como completada\n  - Registra a los 8 alumnos restantes como 'falta'\n  - Exporta autom\u00e1ticamente el archivo CSV:\n    /data/reportes/sesion-20.csv\n\u2022 Confirmaci\u00f3n instant\u00e1nea en la interfaz f\u00edsica",
      "lineHeight": 1.25
    },
