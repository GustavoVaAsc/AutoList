    {
      "id": "87901238",
      "type": "text",
      "x": 1630,
      "y": 1005,
      "width": 338.14,
      "height": 110.0,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 759055564,
      "version": 1,
      "versionNonce": 277024334,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2713 Enrolamiento 100% funcional v\u00eda Web + NPU\n\u2713 Inferencia en tiempo real (~25 ms en NPU)\n\u2713 Comparaci\u00f3n biom\u00e9trica con 100% de confianza\n\u2713 Tolerancia de 10 min asigna 'retardo' correctamente\n\u2713 Bloqueo de asistencias duplicadas verificado\n\u2713 Sincronizaci\u00f3n bidireccional con pantalla f\u00edsica\n\u2713 Cierre t\u00e1ctil de sesi\u00f3n y exportaci\u00f3n CSV \u00edntegra\n\u2713 Sistema operativo de inicio a fin sin fisuras",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9.9,
      "containerId": null,
      "originalText": "\u2713 Enrolamiento 100% funcional v\u00eda Web + NPU\n\u2713 Inferencia en tiempo real (~25 ms en NPU)\n\u2713 Comparaci\u00f3n biom\u00e9trica con 100% de confianza\n\u2713 Tolerancia de 10 min asigna 'retardo' correctamente\n\u2713 Bloqueo de asistencias duplicadas verificado\n\u2713 Sincronizaci\u00f3n bidireccional con pantalla f\u00edsica\n\u2713 Cierre t\u00e1ctil de sesi\u00f3n y exportaci\u00f3n CSV \u00edntegra\n\u2713 Sistema operativo de inicio a fin sin fisuras",
      "lineHeight": 1.25
    },
