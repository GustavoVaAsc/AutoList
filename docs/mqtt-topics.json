    {
      "topic": "aula/vision/resultado",
      "dir": "pub",
      "publisher": "servicio de vision (NPU)",
      "subscribers": [
        "Node-RED"
      ],
      "qos": 1,
      "retained": false,
      "payload": [
        {
          "name": "cuenta",
          "type": "string",
          "required": true
        },
        {
          "name": "conf",
          "type": "float",
          "required": true,
          "min": 0,
          "max": 1
        },
        {
          "name": "lat_ms",
          "type": "object",
          "required": true,
          "fields": [
            {
              "name": "cap",
              "type": "int",
              "required": true
            },
            {
              "name": "det",
              "type": "int",
              "required": true
            },
            {
              "name": "emb",
              "type": "int",
              "required": true
            },
            {
              "name": "total",
              "type": "int",
              "required": true
            }
          ]
        },
        {
          "name": "motivo",
          "type": "string",
          "required": false,
          "enum": [
            "imagen_insuficiente",
            "desconocido",
            "duplicado"
          ]
        }
      ],
      "example": {
        "cuenta": "320068234",
        "conf": 0.78,
        "lat_ms": {
          "cap": 180,
          "det": 12,
          "emb": 6,
          "total": 240
        }
      },
      "nota": "conf es la similitud coseno, entre 0 y 1. cuenta va vacia cuando no se reconoce a nadie. motivo aparece cuando el intento no produce un registro valido."
    },
    {
      "topic": "aula/vision/cmd",
      "dir": "pub",
      "required_if": [
        {
          "when": {
            "accion": "enrolar"
          },
          "require": [
            "cuenta"
          ]
        },
        {
          "when": {
            "accion": "probar"
          },
          "require": [
            "cuenta"
          ]
        }
      ],
      "publisher": "Node-RED",
      "subscribers": [
        "servicio de vision (NPU)"
      ],
      "qos": 1,
      "retained": false,
      "payload": [
        {
          "name": "accion",
          "type": "string",
          "required": true,
          "enum": [
            "enrolar",
            "cancelar",
            "probar"
          ]
        },
        {
          "name": "cuenta",
          "type": "string",
          "required": false
        }
      ],
      "example": {
        "accion": "enrolar",
        "cuenta": "320068234"
      },
      "nota": "Ordenes al servicio de vision. cuenta es obligatoria en enrolar y probar y opcional en cancelar. Mientras hay un registro en curso, el servicio de vision ignora el PIR."
    },
    {
      "topic": "aula/vision/enrolamiento",
      "dir": "pub",
