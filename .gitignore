# Documento interno del equipo: notas de trabajo, estado y pendientes.
# No se versiona; lo que ve el profesor es docs/HIGH-LEVEL-PLAN.md.
docs/SPEC.md
docs/PODA.md

# Credenciales: el .env real (orangepi/.env) nunca se versiona, a cualquier
# profundidad; solo se versiona orangepi/.env.example
.env
.env.*
!.env.example

# Modelos y datasets: fuera de git, van en releases o en una carpeta compartida
*.nb
*.onnx
*.tflite

# Datasets de imagenes (recortes de rostros, datos biometricos): fuera de git.
# Reglas estrechas, solo para los directorios de dataset previstos: las imagenes
# legitimas que ya estan versionadas (docs/diagramas/img/) siguen rastreandose.
# NO se ignora *.png ni *.jpg en general.
/dataset/
/datos/
/lfw/
/herramientas/salida*/
/herramientas/salida-*

# Dependencias y builds
node_modules/
web/dist/
web/build/
orangepi/vision/build/
herramientas/puente_aula/build/

# Artefactos del firmware de la XIAO: el .bin, el .elf y los .cpp
# preprocesados llevan el SSID y las claves en claro, como secrets.h. El build
# del firmware va a un directorio temporal, pero esto cubre que alguien use
# --build-path dentro del repo.
firmware/**/build/
firmware/**/build*/
firmware/**/out/
firmware/**/sketch/
firmware/**/*.bin
firmware/**/*.elf
firmware/**/*.ino.cpp
firmware/**/*.merged.cpp

# Sistema
.DS_Store
Thumbs.db
*.swp

# Archivos que Node-RED escribe junto a flows.json al desplegar: la copia de
# respaldo y el temporal del rename atómico (flows.json.$$$)
nodered/flows/.flows*.backup
nodered/flows/*.$$$
# Red de seguridad: las credenciales de Node-RED viven en el volumen /data, no aquí
nodered/flows/*_cred.json

# Entorno virtual de la pantalla
orangepi/pantalla/.venv/
__pycache__/

# Secretos del firmware de la XIAO (Wi-Fi y clave MQTT de xiao): solo se versiona secrets.h.example
firmware/**/secrets.h
