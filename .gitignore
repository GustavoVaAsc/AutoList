# Documento interno del equipo: notas de trabajo, estado y pendientes.
# No se versiona; lo que ve el profesor es docs/HIGH-LEVEL-PLAN.md.
docs/SPEC.md

# Credenciales: solo se versiona .env.example
.env
.env.*
!.env.example

# Modelos y datasets: fuera de git, van en releases o en una carpeta compartida
*.nb
*.onnx
*.tflite

# Dependencias y builds
node_modules/
web/dist/
web/build/

# Sistema
.DS_Store
Thumbs.db
*.swp

# Builds de firmware (PlatformIO y Arduino)
firmware/**/build/
firmware/**/.pio/
*.elf
*.bin
*.hex
*.map

# Build de C++ del servicio de vision
cmake-build*/
build/
*.o
*.so
*.a

# Python de la pantalla y de las herramientas
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Web: cache del bundler
.vite/

# Datos de runtime: no se versionan, se regeneran
nodered/data/
pc/grafana/data/
*.db-journal
*.db-wal
*.db-shm

# Secretos y claves privadas
secrets/
*.secret
id_rsa*
!id_rsa.pub
id_ed25519*
id_nodered*
*.ppk
*.p12
*.pfx

# TLS: *.key y *.pem son material de clave y nunca se versionan; *.crt es un
# certificado y puede versionarse.
*.pem
*.key

# Credenciales del broker Mosquitto: se crean con "mosquitto passwd -c" y son
# las contrasenas del broker en claro, asi que no se versionan.
mosquitto/passwd
mosquitto/passwd.bak

# Copias de la base de datos
*.dump
*.backup
pg_dump*
dump.sql

# docker-compose.override.yml NO se ignora: queda pendiente de decidir en la
# Capa 3 si se versiona.
