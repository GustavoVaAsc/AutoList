# Plantilla de configuracion del proyecto.
# Copiar a .env en la raiz y rellenar los valores. El .env NO se versiona.
# Los valores sensibles se dejan vacios a proposito: se rellenan en el .env local.

# --- MQTT (Mosquitto en la Orange Pi) -------------------------------------
# Host donde corre el broker. La Orange Pi en la red local del aula.
MQTT_HOST=
# Puerto TCP del broker.
MQTT_PORT=1883
# Puerto del listener WebSocket, usado por el frontend web via mqtt.js.
MQTT_WS_PORT=9001

# --- Credenciales del broker (Mosquitto) ----------------------------------
# Un usuario por rol del sistema. Los nombres son los de la ACL de
# docs/protocolos.md (seccion 3): frontend, xiao, vision, pantalla, sistema y
# nodered. El rol "sistema" es el agente de metricas del host de la Orange Pi.
# Se rellenan en el .env local; los valores sensibles se dejan vacios.
# El frontend usa su par en el listener WebSocket (9001) y no tiene permiso de
# escritura en ningun topico.
MQTT_USER_FRONTEND=
MQTT_PASSWORD_FRONTEND=
MQTT_USER_XIAO=
MQTT_PASSWORD_XIAO=
MQTT_USER_VISION=
MQTT_PASSWORD_VISION=
MQTT_USER_PANTALLA=
MQTT_PASSWORD_PANTALLA=
MQTT_USER_SISTEMA=
MQTT_PASSWORD_SISTEMA=
MQTT_USER_NODERED=
MQTT_PASSWORD_NODERED=

# --- Postgres (PC, con pgvector) -------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
# Se rellena en el .env local.
POSTGRES_PASSWORD=
POSTGRES_DB=asistencia

# --- InfluxDB (Orange Pi) ---------------------------------------------------
# URL base de la API de InfluxDB.
INFLUXDB_URL=http://localhost:8086
# Token de acceso. Se rellena en el .env local.
INFLUXDB_TOKEN=
INFLUXDB_ORG=aula
INFLUXDB_BUCKET=asistencia

# --- Grafana (PC) ----------------------------------------------------------
GRAFANA_ADMIN_USER=
# Se rellena en el .env local.
GRAFANA_ADMIN_PASSWORD=
# URL del datasource de Postgres que consulta Grafana.
GRAFANA_POSTGRES_URL=

# --- SSH de Node-RED (reinicio de la pantalla) ----------------------------
# Host de la Orange Pi donde corre la pantalla como unidad systemd.
SSH_HOST=
SSH_USER=orangepi
# Path de la clave restringida montada en /data del contenedor de Node-RED.
SSH_KEY_PATH=/data/id_nodered

# --- Node-RED --------------------------------------------------------------
# Secreto de cifrado de las credenciales de Node-RED (credentialSecret).
# Solo existe en el .env de la Orange Pi y nunca en el repo: sin el, los
# bloques "creds" de nodered/flows.json (que si se versiona) no se descifran.
NODERED_CREDENTIAL_SECRET=

# --- Parametros del proyecto ----------------------------------------------
# Dimension del embedding (debe coincidir con el vector de Postgres).
EMBEDDING_DIM=512
# Prefijo base de todos los topicos MQTT. Es un valor FIJO en la v1: no se
# cambia. El prefijo "aula/" esta fijado en la ACL de docs/protocolos.md
# (seccion 3) y en docs/mqtt-topics.json; cambiarlo obligaria a regenerar
# los dos a la vez.
MQTT_BASE_TOPIC=aula
# Tolerancia de retardo por defecto, en minutos.
TOLERANCIA_MIN=10
